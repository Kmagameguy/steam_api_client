# Get your own key from https://steamcommunity.com/dev/apikey
STEAM_API_KEY="secret"

# Match this to the domain you used to register your API key.
# This value will be included in the User Agent header of all requests.
STEAM_API_KEY_DOMAIN="your-domain.com"

# Optional; the project will use this value by default.
STEAM_API_ROOT_URL="https://api.steampowered.com"
# Optional; IRB will automatically define a "my_user" convenience method if you define this value.
MY_STEAM_ID=""
